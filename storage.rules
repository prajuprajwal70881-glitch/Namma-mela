rules_version = '2';

// Craft rules based on data in your Storage bucket
// See https://firebase.google.com/docs/storage/security for more information
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read/write access to all users under authentication
      allow read, write: if request.auth != null;
    }
  }
}
